#include <iostream>
using namespace std;
struct Node {
    int coach;
    Node* next;
};
// Add coach at beginning
void addBeginning(Node*& head, int coach) {
    Node* newNode = new Node();
    newNode->coach = coach;
    newNode->next = head;
    head = newNode;
}
// Add coach at end
void addEnd(Node*& head, int coach) {
    Node* newNode = new Node();
    newNode->coach = coach;
    newNode->next = NULL;
  if (head == NULL) {
        head = newNode;
        return;
    }
Node* temp = head;
    while (temp->next != NULL)
        temp = temp->next;
        temp->next = newNode;
}
// Remove a coach
void removeCoach(Node*& head, int coach) {
    if (head == NULL)
        return;
 if (head->coach == coach) {
        Node* temp = head;
        head = head->next;
        delete temp;
        return;
    }
 Node* temp = head;
 while (temp->next != NULL && temp->next->coach != coach)
        temp = temp->next;
 if (temp->next != NULL) {
        Node* del = temp->next;
        temp->next = del->next;
        delete del;
    }
}
// Display coaches
void display(Node* head) {
    Node* temp = head;
 while (temp != NULL) {
        cout << "Coach " << temp->coach;
 if (temp->next != NULL)
            cout << " -> ";
temp = temp->next;
    }
 cout << endl;
}
int main() {
    Node* head = NULL;
// Initial coaches
    addEnd(head, 1);
    addEnd(head, 2);
    addEnd(head, 3);
    addEnd(head, 4);
   cout << "Initial coaches:" << endl;
    display(head);
 // 1. Add coach at beginning
    addBeginning(head, 0);
cout << "\nAfter adding Coach 0 at the beginning:" << endl;
    display(head);
 // 2. Add coach at end
    addEnd(head, 5);
cout << "\nAfter adding Coach 5 at the end:" << endl;
    display(head);
// 3. Remove a coach
    removeCoach(head, 3);
cout << "\nAfter removing Coach 3:" << endl;
    display(head);
 // 4. Display all coaches
    cout << "\nFinal coaches:" << endl;
    display(head);
 return 0;
}
